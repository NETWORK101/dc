{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BASE_URL": "https://agentsandhumans.ai",
    // URLs fetched per cron tick. Keep under the subrequest limit of the plan (50 free, 1000 paid).
    "BATCH": "40",
    // Off-site links are checked with HEAD (GET fallback). Set to "false" to skip them.
    "CHECK_EXTERNALS": "true",
    // Paths that are never crawled (POST-only endpoints, feeds that expand forever).
    "IGNORE": "/api/,/storybook/iframe.html"
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "triggers": {
    // Every 10 minutes: one batch per tick, so a full sweep of ~250 URLs finishes in about an hour
    // and a new sweep starts once a day.
    "crons": ["*/10 * * * *"]
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): ADMIN_KEY (protects /run and /reset),
  // SLACK_WEBHOOK_URL (optional: a message when a sweep finishes with new breakages)
}
